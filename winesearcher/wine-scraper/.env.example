# Copy to .env — placeholders only, never commit real values
PORT=5000
DATABASE_URL="file:./dev.db?connection_limit=1&socket_timeout=60"
# Required for POST /api/refresh and POST /api/import (without it these return 503)
ADMIN_TOKEN=change-me-long-random-string
# Comma-separated allowed browser origins (empty = same-origin only)
CORS_ORIGINS=
# Providers: mock is for development; winesearcher-api needs a licensed key from the client
PROVIDER=mock
WINESEARCHER_API_KEY=
# Cron expression for scheduled refresh (empty = disabled)
REFRESH_CRON=
# Hours after which a verified offer is considered stale
STALE_AFTER_HOURS=48
